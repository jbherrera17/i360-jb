# ═══════════════════════════════════════════════════════════
# INSIGHT 360 - Staging Environment Configuration
# Set these as environment variables in Railway (staging service)
# ═══════════════════════════════════════════════════════════

NODE_ENV=production
ENVIRONMENT=staging
PORT=3000

# Supabase (use STAGING project, not production)
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_KEY=your-staging-service-key

# LLM API Keys (same keys work for both environments)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# CORS - your staging domain
ALLOWED_ORIGINS=https://insight360-staging.up.railway.app

# Optional services
BRAVE_SEARCH_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_API_KEY=
