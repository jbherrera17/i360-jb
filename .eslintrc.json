{
  "env": {
    "node": true,
    "es2021": true,
    "browser": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "globals": {
    "lucide": "readonly",
    "ModalService": "readonly",
    "ModalBase": "readonly",
    "FormModal": "readonly",
    "ChatModal": "readonly",
    "ContentModal": "readonly",
    "ConfirmModal": "readonly",
    "AlertModal": "readonly",
    "PromptModal": "readonly",
    "AgentModal": "readonly",
    "CreateAssetModal": "readonly",
    "HelpModal": "readonly",
    "HelpRegistry": "readonly",
    "Sanitize": "readonly",
    "marked": "readonly",
    "hljs": "readonly",
    "Prism": "readonly",
    "Chart": "readonly",
    "showToast": "readonly",
    "getSelectedModel": "readonly",
    "LoadingMessages": "readonly",
    "DraggableMixin": "readonly",
    "ResizableMixin": "readonly",
    "FullscreenMixin": "readonly",
    "PersistenceMixin": "readonly",
    "streamTimeout": "readonly",
    "escapeHtml": "readonly",
    "SessionTimeout": "readonly",
    "AuthFetch": "readonly",
    "authFetch": "readonly",
    "BrandingService": "readonly",
    "UsageNudge": "readonly",
    "IconPicker": "readonly",
    "initNavigation": "readonly",
    "ModalServiceLoader": "readonly"
  },
  "ignorePatterns": ["node_modules/", "coverage/", "playwright-report/"],
  "plugins": ["no-raw-fetch"],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-case-declarations": "warn",
    "no-prototype-builtins": "warn",
    "no-useless-escape": "warn",
    "no-constant-condition": "warn",
    "no-redeclare": "warn",
    "no-raw-fetch/no-raw-fetch": "error"
  },
  "overrides": [
    {
      "files": ["public/js/auth-fetch.js", "public/js/auth-fetch-loader.js", "public/login.html", "public/js/navigation.js", "public/js/session-timeout.js"],
      "rules": {
        "no-raw-fetch/no-raw-fetch": "off"
      }
    },
    {
      "files": ["server/**/*.js", "__tests__/**/*.js"],
      "rules": {
        "no-raw-fetch/no-raw-fetch": "off"
      }
    },
    {
      "files": ["public/js/chat.js", "public/js/chat/*.js"],
      "rules": {
        "no-undef": "off"
      }
    }
  ]
}
