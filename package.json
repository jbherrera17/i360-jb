    "openai": "^6.21.0",
    "pdf-parse": "^1.1.1",
    "prom-client": "^15.1.3",
    "rss-parser": "^3.13.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "readable-stream": "^4.7.0",
    "supertest": "^7.0.0"
