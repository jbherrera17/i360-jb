    "@modelcontextprotocol/sdk": "^1.27.1",
    "@mozilla/readability": "^0.6.0",
    "@notionhq/client": "^5.6.0",
    "@supabase/supabase-js": "^2.45.0",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.6.3",
    "jsdom": "^28.0.0",
    "mammoth": "^1.8.0",
    "mindstudio": "^0.9.7",
