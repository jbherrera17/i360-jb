# ═══════════════════════════════════════════════════════════
# INSIGHT 360 - Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development

# ═══════════════════════════════════════════════════════════
# LLM API KEYS (Required - at least one)
# ═══════════════════════════════════════════════════════════

# Anthropic Claude
# Get your key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI GPT (also enables voice features)
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Google AI (optional)
# Get your key: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Perplexity Sonar (optional)
# Get your key: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# ═══════════════════════════════════════════════════════════
# WEB SEARCH (Optional - one of these for web search)
# ═══════════════════════════════════════════════════════════

# Brave Search API (recommended)
# Get your key: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=your-brave-search-key-here

# Tavily Search API (alternative)
# Get your key: https://tavily.com/
TAVILY_API_KEY=

# Serper API (alternative)
# Get your key: https://serper.dev/
SERPER_API_KEY=

# ═══════════════════════════════════════════════════════════
# SUPABASE (Required for database features)
# ═══════════════════════════════════════════════════════════

# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-key-here

# ═══════════════════════════════════════════════════════════
# CORS (Optional)
# ═══════════════════════════════════════════════════════════

# Comma-separated list of allowed origins (update for production)
ALLOWED_ORIGINS=http://localhost:3000

# Base URL of your application (used for email invitation redirect links)
# Development: http://localhost:3000
# Production: https://your-domain.com
APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════
# SOCIAL MEDIA PUBLISHING (Optional - Postiz Integration)
# ═══════════════════════════════════════════════════════════

# Postiz API URL (Railway internal network or public URL)
# Deploy Postiz: https://railway.com/deploy/postiz
POSTIZ_API_URL=http://localhost:3001

# Postiz frontend URL (for OAuth redirects)
POSTIZ_FRONTEND_URL=http://localhost:4200

# Token encryption key (32 bytes hex) - shared with LinkedIn OAuth
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
