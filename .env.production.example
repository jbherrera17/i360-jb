# ═══════════════════════════════════════════════════════════
# INSIGHT 360 - Production Environment Configuration
# Set these as environment variables in Railway (production service)
# ═══════════════════════════════════════════════════════════

NODE_ENV=production
ENVIRONMENT=production
PORT=3000

# Supabase Pro (PRODUCTION project)
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_KEY=your-production-service-key

# LLM API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# CORS - your production domain(s), comma-separated
ALLOWED_ORIGINS=https://app.insight360.ai,https://insight360.up.railway.app

# Optional services
BRAVE_SEARCH_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_API_KEY=

# Token encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TOKEN_ENCRYPTION_KEY=generate-a-new-key-never-reuse
